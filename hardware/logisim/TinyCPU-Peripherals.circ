<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="4.1.0" version="1.0">
  This file defines the AP-18 system boundary; functional integration is staged.
  <lib desc="#Wiring" name="0"><tool name="Pin"><a name="appearance" val="classic"/></tool></lib>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#FPArithmetic" name="4"/>
  <lib desc="#Memory" name="5"/>
  <lib desc="#I/O" name="6"/>
  <lib desc="#TTL" name="7"/>
  <lib desc="#TCL" name="8"/>
  <lib desc="#Base" name="9"/>
  <main name="TinyCPUSystemMain"/>
  <options><a name="gateUndefined" val="ignore"/><a name="simlimit" val="1000"/><a name="simrand" val="0"/></options>
  <mappings/>
  <toolbar/>
  <circuit name="TinyCPUSystemMain">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="TinyCPUSystemMain"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(200,200)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="east"/>
      <a name="label" val="CLK"/>
    </comp>
    <comp lib="0" loc="(200,240)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="east"/>
      <a name="label" val="RESET"/>
    </comp>
    <comp lib="0" loc="(200,280)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="east"/>
      <a name="label" val="INTERRUPT_REQUEST"/>
    </comp>
    <comp lib="0" loc="(800,200)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="label" val="OUTPUT_PORT_VALUE"/>
      <a name="type" val="output"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="0" loc="(800,240)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="label" val="OUTPUT_PORT_VALID"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="0" loc="(800,280)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="label" val="INTERRUPT_ENABLED"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="0" loc="(800,320)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="label" val="INTERRUPT_PENDING"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="0" loc="(800,360)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="label" val="IN_INTERRUPT_HANDLER"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="0" loc="(800,400)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="label" val="RETURN_ADDRESS"/>
      <a name="type" val="output"/>
      <a name="width" val="12"/>
    </comp>
    <comp lib="0" loc="(800,440)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="label" val="RETURN_ADDRESS_VALID"/>
      <a name="type" val="output"/>
    </comp>
  </circuit>
  <circuit name="OutputPort">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="OutputPort"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(180,140)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="WRITE_VALUE"/><a name="width" val="16"/></comp>
    <comp lib="0" loc="(180,200)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="WRITE_VALID"/></comp>
    <comp lib="0" loc="(180,260)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="WRITE_ENABLE"/></comp>
    <comp lib="0" loc="(180,320)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="CLK"/></comp>
    <comp lib="0" loc="(180,380)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="RESET"/></comp>
    <comp lib="0" loc="(600,140)" name="Pin"><a name="appearance" val="classic"/><a name="facing" val="west"/><a name="label" val="VALUE"/><a name="type" val="output"/><a name="width" val="16"/></comp>
    <comp lib="0" loc="(600,240)" name="Pin"><a name="appearance" val="classic"/><a name="facing" val="west"/><a name="label" val="VALID"/><a name="type" val="output"/></comp>
    <comp lib="5" loc="(430,110)" name="Register"><a name="appearance" val="logisim_evolution"/><a name="label" val="OUTPUT_VALUE"/><a name="width" val="16"/></comp>
    <comp lib="5" loc="(430,210)" name="Register"><a name="appearance" val="logisim_evolution"/><a name="label" val="OUTPUT_VALID"/><a name="width" val="1"/></comp>
    <comp lib="9" loc="(190,70)" name="Text"><a name="text" val="AP-18 output port: value and validity are written atomically; reset clears both registers"/></comp>
    <wire from="(180,140)" to="(430,140)"/>
    <wire from="(180,200)" to="(300,200)"/>
    <wire from="(300,200)" to="(300,240)"/>
    <wire from="(300,240)" to="(430,240)"/>
    <wire from="(180,260)" to="(330,260)"/>
    <wire from="(330,160)" to="(330,260)"/>
    <wire from="(330,160)" to="(430,160)"/>
    <wire from="(330,260)" to="(430,260)"/>
    <wire from="(180,320)" to="(350,320)"/>
    <wire from="(350,180)" to="(350,320)"/>
    <wire from="(350,180)" to="(430,180)"/>
    <wire from="(350,280)" to="(350,320)"/>
    <wire from="(350,280)" to="(430,280)"/>
    <wire from="(180,380)" to="(460,380)"/>
    <wire from="(460,200)" to="(460,380)"/>
    <wire from="(460,200)" to="(460,210)"/>
    <wire from="(460,300)" to="(460,380)"/>
    <wire from="(460,300)" to="(460,310)"/>
    <wire from="(490,140)" to="(600,140)"/>
    <wire from="(490,240)" to="(600,240)"/>
  </circuit>
  <circuit name="OutputMemoryPath">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="OutputMemoryPath"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(160,120)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="ADDRESS"/><a name="width" val="12"/></comp>
    <comp lib="0" loc="(160,180)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="WRITE_VALUE"/><a name="width" val="16"/></comp>
    <comp lib="0" loc="(160,220)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="WRITE_VALID"/></comp>
    <comp lib="0" loc="(160,260)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="WRITE_ENABLE"/></comp>
    <comp lib="0" loc="(160,320)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="RAM_READ_VALUE"/><a name="width" val="16"/></comp>
    <comp lib="0" loc="(160,360)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="RAM_READ_VALID"/></comp>
    <comp lib="0" loc="(160,420)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="CLK"/></comp>
    <comp lib="0" loc="(160,460)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="RESET"/></comp>
    <comp lib="0" loc="(800,140)" name="Pin"><a name="appearance" val="classic"/><a name="facing" val="west"/><a name="label" val="READ_VALUE"/><a name="type" val="output"/><a name="width" val="16"/></comp>
    <comp lib="0" loc="(800,180)" name="Pin"><a name="appearance" val="classic"/><a name="facing" val="west"/><a name="label" val="READ_VALID"/><a name="type" val="output"/></comp>
    <comp lib="0" loc="(800,240)" name="Pin"><a name="appearance" val="classic"/><a name="facing" val="west"/><a name="label" val="RAM_WRITE_ENABLE"/><a name="type" val="output"/></comp>
    <comp lib="0" loc="(800,300)" name="Pin"><a name="appearance" val="classic"/><a name="facing" val="west"/><a name="label" val="OUTPUT_PORT_VALUE"/><a name="type" val="output"/><a name="width" val="16"/></comp>
    <comp lib="0" loc="(800,340)" name="Pin"><a name="appearance" val="classic"/><a name="facing" val="west"/><a name="label" val="OUTPUT_PORT_VALID"/><a name="type" val="output"/></comp>
    <comp lib="0" loc="(260,100)" name="Constant"><a name="value" val="0xfff"/><a name="width" val="12"/></comp>
    <comp lib="3" loc="(350,120)" name="Comparator"><a name="label" val="OUTPUT_ADDRESS_DECODE"/><a name="width" val="12"/></comp>
    <comp lib="1" loc="(470,240)" name="NOT Gate"><a name="label" val="NOT_OUTPUT_ADDRESS"/></comp>
    <comp lib="1" loc="(570,240)" name="AND Gate"><a name="label" val="RAM_WRITE_GATE"/></comp>
    <comp lib="1" loc="(570,280)" name="AND Gate"><a name="label" val="OUTPUT_WRITE_GATE"/></comp>
    <comp lib="2" loc="(690,140)" name="Multiplexer"><a name="label" val="OUTPUT_READ_VALUE_SELECT"/><a name="width" val="16"/></comp>
    <comp lib="2" loc="(690,180)" name="Multiplexer"><a name="label" val="OUTPUT_READ_VALID_SELECT"/></comp>
    <comp loc="(650,360)" name="OutputPort"><a name="label" val="OUTPUT_PORT"/></comp>
    <comp lib="9" loc="(170,60)" name="Text"><a name="text" val="AP-18 address 0xfff bypasses RAM writes and selects the clocked output port for reads"/></comp>
  </circuit>
