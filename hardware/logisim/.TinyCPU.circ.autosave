    <comp lib="9" loc="(1885,1385)" name="Text">
      <a name="text" val="HALT: hält die CPU regulär an"/>
    </comp>
    <comp lib="9" loc="(1900,1350)" name="Text">
      <a name="text" val="PRINT: gibt den Akkumulator aus"/>
    </comp>
    <comp lib="9" loc="(1930,1145)" name="Text">
      <a name="text" val="SET_OVF: setzt den Überlauffehler"/>
    </comp>
    <comp lib="9" loc="(1940,1210)" name="Text">
      <a name="text" val="SET_INV: setzt den Ungültigkeitsfehler"/>
    </comp>
    <comp lib="9" loc="(1940,1325)" name="Text">
      <a name="text" val="INPUT: liest einen Wert in den Akkumulator"/>
    </comp>
    <comp lib="9" loc="(1945,1185)" name="Text">
      <a name="text" val="SET_ADDR: setzt den Adressfehler"/>
    </comp>
    <comp lib="9" loc="(1950,825)" name="Text">
      <a name="text" val="INVERT: invertiert den Akkumulator bitweise"/>
    </comp>
    <comp lib="9" loc="(1955,1285)" name="Text">
      <a name="text" val="SET_INPUT: setzt den Eingabefehler"/>
    </comp>
    <comp lib="9" loc="(1980,1170)" name="Text">
      <a name="text" val="SET_DIV0: setzt den Fehler Division durch null"/>
    </comp>
    <comp lib="9" loc="(1980,1245)" name="Text">
      <a name="text" val="SET_ILL: setzt den Fehler für unbekannte Befehle"/>
    </comp>
    <comp lib="9" loc="(1980,845)" name="Text">
      <a name="text" val="JUMP_ADR: springt unbedingt zur Adresse"/>
    </comp>
    <comp lib="9" loc="(1990,1435)" name="Text">
      <a name="text" val="HALT_ERROR: hält die CPU mit Fehler an"/>
    </comp>
    <comp lib="9" loc="(2005,1305)" name="Text">
      <a name="text" val="CLEAR_ERROR: löscht alle Fehlermerker"/>
    </comp>
    <comp lib="9" loc="(2005,985)" name="Text">
      <a name="text" val="LOAD_ADR: lädt den Speicherwert an der Adresse"/>
    </comp>
    <comp lib="9" loc="(2020,865)" name="Text">
      <a name="text" val="JUMP_ZERO: springt, wenn der Akkumulator null ist"/>
    </comp>
    <comp lib="9" loc="(2035,1365)" name="Text">
      <a name="text" val="PRINT_ADR: gibt den Speicherwert an der Adresse aus"/>
    </comp>
    <comp lib="9" loc="(2040,1085)" name="Text">
      <a name="text" val="STORE_ADR: speichert den Akkumulator an der Adresse"/>
    </comp>
    <comp lib="9" loc="(2040,925)" name="Text">
      <a name="text" val="JUMP_ERROR: springt, wenn ein Fehler gesetzt ist"/>
    </comp>
    <comp lib="9" loc="(2045,965)" name="Text">
      <a name="text" val="LOAD_CONST: lädt die Konstante in den Akkumulator"/>
    </comp>
    <comp lib="9" loc="(2050,90)" name="Text">
      <a name="text" val="ADD_OPERAND: addiert den gewählten Operanden"/>
    </comp>
    <comp lib="9" loc="(2065,150)" name="Text">
      <a name="text" val="SUB_OPERAND: subtrahiert den gewählten Operanden"/>
    </comp>
    <comp lib="9" loc="(2070,270)" name="Text">
      <a name="text" val="DIV_OPERAND: dividiert durch den gewählten Operanden"/>
    </comp>
    <comp lib="9" loc="(2075,1045)" name="Text">
      <a name="text" val="LD_REG_CONST: lädt die Konstante in das Adressregister"/>
    </comp>
    <comp lib="9" loc="(2075,1065)" name="Text">
      <a name="text" val="LD_REG_ADR: lädt das Adressregister aus der Speicheradresse"/>
    </comp>
    <comp lib="9" loc="(2080,1005)" name="Text">
      <a name="text" val="LOAD_ADR_REG: lädt den Speicherwert am Adressregister"/>
    </comp>
    <comp lib="9" loc="(2085,210)" name="Text">
      <a name="text" val="MUL_OPERAND: multipliziert mit dem gewählten Operanden"/>
    </comp>
    <comp lib="9" loc="(2090,385)" name="Text">
      <a name="text" val="OR_OPERAND: bitweises ODER mit dem gewählten Operanden"/>
    </comp>
    <comp lib="9" loc="(2090,905)" name="Text">
      <a name="text" val="JUMP_NEGATIVE: springt, wenn der Akkumulator negativ ist"/>
    </comp>
    <comp lib="9" loc="(2095,445)" name="Text">
      <a name="text" val="XOR_OPERAND: bitweises XOR mit dem gewählten Operanden"/>
    </comp>
    <comp lib="9" loc="(2100,325)" name="Text">
      <a name="text" val="AND_OPERAND: bitweises UND mit dem gewählten Operanden"/>
    </comp>
    <comp lib="9" loc="(2105,890)" name="Text">
      <a name="text" val="JUMP_NOT_ZERO: springt, wenn der Akkumulator nicht null ist"/>
    </comp>
    <comp lib="9" loc="(2105,945)" name="Text">
      <a name="text" val="JUMP_NOT_ERROR: springt, wenn kein Fehler gesetzt ist"/>
    </comp>
    <comp lib="9" loc="(2115,1105)" name="Text">
      <a name="text" val="STORE_ADR_REG: speichert den Akkumulator am Adressregister"/>
    </comp>
    <comp lib="9" loc="(2120,1025)" name="Text">
      <a name="text" val="LOAD_REG_OFF: lädt den Speicherwert bei Adressregister plus Offset"/>
    </comp>
    <comp lib="9" loc="(2120,515)" name="Text">
      <a name="text" val="CONST_ARGUMENT: verwendet die Konstante als Argument"/>
    </comp>
    <comp lib="9" loc="(2120,600)" name="Text">
      <a name="text" val="ADDR_ARGUMENT: verwendet den Speicherwert an der Adresse"/>
    </comp>
    <comp lib="9" loc="(2135,1495)" name="Text">
      <a name="text" val="INVALID_OPERAND: meldet einen reservierten Opcode als ungültig"/>
    </comp>
    <comp lib="9" loc="(2155,1125)" name="Text">
      <a name="text" val="STORE_REG_OFF: speichert den Akkumulator bei Adressregister plus Offset"/>
    </comp>
    <comp lib="9" loc="(2200,675)" name="Text">
      <a name="text" val="ADDR_REG_ARGUMENT: verwendet den Speicherwert am Adressregister"/>
    </comp>
    <comp lib="9" loc="(2210,1665)" name="Text">
      <a name="text" val="ACC_WRITE_REQUEST: schreibt das Operationsergebnis in den Akkumulator"/>
    </comp>
    <comp lib="9" loc="(2225,1580)" name="Text">
      <a name="text" val="ACC_MEMORY_REQUEST: fordert einen Speicherwert für den Akkumulator an"/>
    </comp>
    <comp lib="9" loc="(2310,760)" name="Text">
      <a name="text" val="ADDR_REG_OFFS_ARGUMENT: verwendet den Speicherwert bei Adressregister plus Offset"/>
    </comp>
    <comp lib="9" loc="(910,895)" name="Text">
      <a name="text" val="RETURN_FROM_INTERRUPT_REQUEST: return from interrupt request"/>
    </comp>
    <comp lib="9" loc="(910,935)" name="Text">
      <a name="text" val="DISABLE_INTERRUPTS_REQUEST: decoded control output"/>
    </comp>
    <comp lib="9" loc="(920,915)" name="Text">
      <a name="text" val="ENABLE_INTERRUPTS_REQUEST: enable interrupts request"/>
    </comp>
