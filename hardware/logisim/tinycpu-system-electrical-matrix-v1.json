{
  "schema_version": 1,
  "schema": "tinycpu-system-electrical-matrix-v1",
  "system": "tinycpu-peripherals-16-12-v1",
  "machine_format": "tinycpu-system-machine-v1",
  "trace_schema": "tinycpu-system-trace-v1",
  "description": "Mandatory VM/Logisim edge-trace cases for the AP-18 output port and interrupt contract.",
  "requirements": {
    "compare": "vm-edge-trace",
    "simulator": "logisim-evolution-4.1.0",
    "all_system_opcodes_required": true,
    "all_system_behaviors_required": true
  },
  "required_behaviors": [
    "output-valid-write",
    "output-invalid-write",
    "masked-request",
    "unmask-and-accept",
    "interrupt-return",
    "reset-idle",
    "reset-pending",
    "reset-handler",
    "illegal-return",
    "invalid-vector"
  ],
  "cases": [
    {
      "id": "output-valid-write",
      "covers": ["output-valid-write"],
      "program": "LOAD_CONST(23)\nSTORE_ADDRESS(4095)\nLOAD_ADDRESS(4095)\nHALT()\n",
      "events": []
    },
    {
      "id": "output-invalid-write",
      "covers": ["output-invalid-write"],
      "program": "LOAD_CONST(23)\nSTORE_ADDRESS(4095)\nLOAD_ADDRESS(20)\nSTORE_ADDRESS(4095)\nHALT_ERROR()\n",
      "events": []
    },
    {
      "id": "masked-request-unmask-return",
      "covers": ["ENABLE_INTERRUPTS", "RETURN_FROM_INTERRUPT", "masked-request", "unmask-and-accept", "interrupt-return"],
      "program": "ENABLE_INTERRUPTS()\nHALT()\n",
      "vector_program": "LOAD_CONST(7)\nRETURN_FROM_INTERRUPT()\n",
      "events": [
        {"edge": 0, "interrupt_request": true},
        {"edge": 1, "interrupt_request": false}
      ]
    },
    {
      "id": "disable-interrupts",
      "covers": ["DISABLE_INTERRUPTS", "masked-request"],
      "program": "ENABLE_INTERRUPTS()\nDISABLE_INTERRUPTS()\nHALT()\n",
      "events": [
        {"edge": 2, "interrupt_request": true}
      ]
    },
    {
      "id": "reset-states",
      "covers": ["reset-idle", "reset-pending", "reset-handler"],
      "program": "ENABLE_INTERRUPTS()\nJUMP_ADDRESS(0)\n",
      "vector_program": "JUMP_ADDRESS(4080)\n",
      "events": [
        {"edge": 0, "reset": true},
        {"edge": 2, "interrupt_request": true},
        {"edge": 3, "interrupt_request": false},
        {"edge": 4, "reset": true},
        {"edge": 7, "interrupt_request": true},
        {"edge": 8, "interrupt_request": false},
        {"edge": 9, "reset": true}
      ]
    },
    {
      "id": "illegal-return",
      "covers": ["RETURN_FROM_INTERRUPT", "illegal-return"],
      "program": "RETURN_FROM_INTERRUPT()\n",
      "events": []
    },
    {
      "id": "invalid-vector",
      "covers": ["ENABLE_INTERRUPTS", "invalid-vector"],
      "program": "ENABLE_INTERRUPTS()\nHALT()\n",
      "events": [
        {"edge": 1, "interrupt_request": true},
        {"edge": 2, "interrupt_request": false}
      ]
    }
  ]
}
